# Copy this file to .env and fill in your real values
# Get these from your Supabase project: https://supabase.com -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: The Anthropic API key is NOT stored here. It is set as a Supabase secret:
#   supabase secrets set ANTHROPIC_API_KEY=your-claude-api-key
# See DEPLOY_EDGE_FUNCTION.md for setup instructions.
